# RxPulse Catalog Service - Production Environment Variables
PORT=3002
NODE_ENV=production

# MongoDB connection (pointing to the private IP of the MongoDB EC2 instance)
# Replace <MONGODB_PRIVATE_IP> with the actual private IP of the MongoDB EC2 instance
MONGO_URI=mongodb://<MONGODB_PRIVATE_IP>:27017/catalog_db

# Security
# MUST match JWT_SECRET in all other microservices for token verification to work
JWT_SECRET=rxpulse_jwt_secret_2024_production_secure_key_change_me

# Service Communication
# Points to the Internal ALB DNS (which routes /api/users to user-service)
AUTH_SERVICE_URL=http://<INTERNAL_ALB_DNS>

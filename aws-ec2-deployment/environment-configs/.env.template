# ==============================================================================
# RxPulse Production Environment Variable Template
# ==============================================================================
# Copy this file to individual services or use it as a reference for setting up
# system-level environment variables on the EC2 instances.
#
# Replace all <PLACEHOLDERS> with actual values before starting services.
# ==============================================================================

# Common Variables
NODE_ENV=production
JWT_SECRET=<STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS>

# user-service (.env name: user-service.env, Port: 3001)
USER_SERVICE_PORT=3001
USER_SERVICE_MONGO_URI=mongodb://<MONGO_DB_PRIVATE_IP>:27017/users_db
USER_SERVICE_JWT_EXPIRES_IN=7d

# catalog-service (.env name: catalog-service.env, Port: 3002)
CATALOG_SERVICE_PORT=3002
CATALOG_SERVICE_MONGO_URI=mongodb://<MONGO_DB_PRIVATE_IP>:27017/catalog_db
CATALOG_SERVICE_AUTH_SERVICE_URL=http://<INTERNAL_ALB_DNS>

# inventory-service (.env name: inventory-service.env, Port: 3003)
INVENTORY_SERVICE_PORT=3003
INVENTORY_SERVICE_MONGO_URI=mongodb://<MONGO_DB_PRIVATE_IP>:27017/inventory_db
INVENTORY_SERVICE_AUTH_SERVICE_URL=http://<INTERNAL_ALB_DNS>
INVENTORY_SERVICE_CATALOG_SERVICE_URL=http://<INTERNAL_ALB_DNS>

# RxPulse User Service - Production Environment Variables
PORT=3001
NODE_ENV=production

# MongoDB connection (pointing to the private IP of the MongoDB EC2 instance)
# Replace <MONGODB_PRIVATE_IP> with the actual private IP of the MongoDB EC2 instance
MONGO_URI=mongodb://<MONGODB_PRIVATE_IP>:27017/users_db

# Security
# Set this to a strong, unique secret key in production (minimum 32 characters)
JWT_SECRET=rxpulse_jwt_secret_2024_production_secure_key_change_me
JWT_EXPIRES_IN=7d
